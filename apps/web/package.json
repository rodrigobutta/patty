{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter shared build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "movil:android": "cap sync android && cap run android",
    "movil:ios": "cap sync ios && cap run ios",
    "movil:dev:android": "node movil/dev.mjs android",
    "movil:dev:ios": "node movil/dev.mjs ios",
    "movil:abrir:android": "cap open android",
    "movil:abrir:ios": "cap open ios",
    "movil:iconos": "pnpm --filter api exec tsx ../web/movil/iconos.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capgo/background-geolocation": "8.4.14",
    "@capgo/capacitor-health": "8.11.12",
    "@capgo/capacitor-social-login": "8.7.5",
    "@capgo/capacitor-speech-recognition": "8.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shared": "workspace:*",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.4"
  }
}
