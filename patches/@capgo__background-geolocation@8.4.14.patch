+package com.capgo.capacitor_background_geolocation;
+
+// Patty: decides, fix by fix, how often the GPS should run and which fixes are worth sending, using only what the fixes
+// say (no activity recognition: no extra permission, and it keeps working on phones that kill Play Services callbacks).
+// Still: GPS at the slow interval, nothing is sent except a rare heartbeat or a real displacement. Moving: GPS every few
+// seconds and a point every 15 m on foot, more spaced out with speed. No Android classes here, so it can be unit tested.
+final class AdaptiveTracker {
+
+    static final int NONE = 0;
+    // Good enough only to know where the phone is (presence at places, stops).
+    static final int COARSE = 1;
+    // Good enough to draw the route.
+    static final int ROUTE = 2;
+
+    static final long MOVING_GPS_INTERVAL_MS = 5000L;
+    // Worse than this, a fix only says roughly where the phone is, it can't be drawn.
+    static final float ROUTE_MAX_ACCURACY_M = 50f;
+
+    // To start moving: this far from where it was resting (and beyond what the fix itself is unsure of), and the fix's own
+    // speed, which comes from the Doppler shift and barely reacts to the position wandering indoors, has to agree.
+    private static final double START_MIN_M = 40;
+    private static final double START_ACCURACY_FACTOR = 1.5;
+    private static final float START_MIN_SPEED_MS = 0.5f;
+
+    // To keep moving: this much progress every STILL_AFTER_MS (a long red light goes back to the slow GPS)...
+    private static final double PROGRESS_M = 30;
+    private static final long STILL_AFTER_MS = 2 * 60000L;
+    // ...and this much net displacement every NET_WINDOW_MS, so that a position wandering indoors can't keep the GPS on.
+    private static final double NET_MIN_M = 50;
+    private static final long NET_WINDOW_MS = 5 * 60000L;
+
+    // Spacing between points: what is covered in SPACING_S at this speed, within these limits (15 m on foot, ~60 m at
+    // 36 km/h, 150 m on the highway).
+    private static final double SPACING_S = 6;
+    private static final double SPACING_MIN_M = 15;
+    private static final double SPACING_MAX_M = 150;
+
+    private static final double COARSE_MIN_M = 100;
+    private static final long COARSE_WHILE_MOVING_MS = 60000L;
+    // Still and with nothing new: one point every this long, so the server keeps getting the weather's location.
+    private static final long HEARTBEAT_MS = 15 * 60000L;
+
+    private boolean moving = false;
+
+    private boolean hasAnchor = false;
+    private double anchorLat;
+    private double anchorLon;
+    private long anchorAtMs;
+
+    private double windowLat;
+    private double windowLon;
+    private long windowAtMs;
+
+    private boolean hasSent = false;
+    private double sentLat;
+    private double sentLon;
+    private long sentAtMs;
+
+    private boolean hasLast = false;
+    private double lastLat;
+    private double lastLon;
+    private long lastAtMs;
+
+    synchronized boolean isMoving() {
+        return moving;
+    }
+
+    // accuracy and speed: negative when the fix doesn't have them. nowMs: a monotonic clock.
+    synchronized int onGpsFix(double lat, double lon, float accuracy, float speed, long nowMs) {
+        boolean good = accuracy >= 0 && accuracy <= ROUTE_MAX_ACCURACY_M;
+        int result = moving ? whileMoving(lat, lon, accuracy, speed, good, nowMs) : whileStill(lat, lon, accuracy, speed, good, nowMs);
+        hasLast = true;
+        lastLat = lat;
+        lastLon = lon;
+        lastAtMs = nowMs;
+        return remember(result, lat, lon, nowMs);
+    }
+
+    // A fix from the network provider (the GPS has been silent for a while): only for presence.
+    synchronized int onCoarseFix(double lat, double lon, long nowMs) {
+        return remember(coarseIfUseful(lat, lon, nowMs), lat, lon, nowMs);
+    }
+
+    // No fix may arrive when moving stops (indoors): called when the GPS goes silent. True if it just went back to still.
+    synchronized boolean expire(long nowMs) {
+        if (moving && nowMs - anchorAtMs >= STILL_AFTER_MS) {
+            moving = false;
+            return true;
+        }
+        return false;
+    }
+
+    private int remember(int result, double lat, double lon, long nowMs) {
+        if (result != NONE) {
+            hasSent = true;
+            sentLat = lat;
+            sentLon = lon;
+            sentAtMs = nowMs;
+        }
+        return result;
+    }
+
+    private int whileStill(double lat, double lon, float accuracy, float speed, boolean good, long nowMs) {
+        if (good && !hasAnchor) {
+            setAnchor(lat, lon, nowMs);
+        } else if (good) {
+            double needed = Math.max(START_MIN_M, accuracy * START_ACCURACY_FACTOR);
+            boolean speedAgrees = speed < 0 || speed >= START_MIN_SPEED_MS;
+            if (speedAgrees && distanceM(anchorLat, anchorLon, lat, lon) >= needed) {
+                moving = true;
+                setAnchor(lat, lon, nowMs);
+                windowLat = lat;
+                windowLon = lon;
+                windowAtMs = nowMs;
+                return ROUTE;
+            }
+        }
+        return coarseIfUseful(lat, lon, nowMs);
+    }
+
+    private int whileMoving(double lat, double lon, float accuracy, float speed, boolean good, long nowMs) {
+        if (!good) {
+            expire(nowMs);
+            boolean late = !hasSent || nowMs - sentAtMs >= COARSE_WHILE_MOVING_MS;
+            return late && movedFromSent(lat, lon, COARSE_MIN_M) ? COARSE : NONE;
+        }
+        if (distanceM(anchorLat, anchorLon, lat, lon) >= Math.max(PROGRESS_M, accuracy)) {
+            setAnchor(lat, lon, nowMs);
+        }
+        if (nowMs - windowAtMs >= NET_WINDOW_MS) {
+            if (distanceM(windowLat, windowLon, lat, lon) < NET_MIN_M) {
+                moving = false;
+                setAnchor(lat, lon, nowMs);
+                return NONE;
+            }
+            windowLat = lat;
+            windowLon = lon;
+            windowAtMs = nowMs;
+        }
+        if (expire(nowMs)) {
+            setAnchor(lat, lon, nowMs);
+            return NONE;
+        }
+        return movedFromSent(lat, lon, spacingM(speedOf(lat, lon, speed, nowMs))) ? ROUTE : NONE;
+    }
+
+    private int coarseIfUseful(double lat, double lon, long nowMs) {
+        if (!hasSent || nowMs - sentAtMs >= HEARTBEAT_MS || movedFromSent(lat, lon, COARSE_MIN_M)) {
+            return COARSE;
+        }
+        return NONE;
+    }
+
+    private boolean movedFromSent(double lat, double lon, double meters) {
+        return !hasSent || distanceM(sentLat, sentLon, lat, lon) >= meters;
+    }
+
+    private double speedOf(double lat, double lon, float speed, long nowMs) {
+        if (speed >= 0) {
+            return speed;
+        }
+        if (!hasLast || nowMs <= lastAtMs) {
+            return 0;
+        }
+        return distanceM(lastLat, lastLon, lat, lon) / ((nowMs - lastAtMs) / 1000.0);
+    }
+
+    static double spacingM(double speedMs) {
+        return Math.min(SPACING_MAX_M, Math.max(SPACING_MIN_M, speedMs * SPACING_S));
+    }
+
+    private void setAnchor(double lat, double lon, long nowMs) {
+        hasAnchor = true;
+        anchorLat = lat;
+        anchorLon = lon;
+        anchorAtMs = nowMs;
+    }
+
+    static double distanceM(double lat1, double lon1, double lat2, double lon2) {
+        double dLat = Math.toRadians(lat2 - lat1);
+        double dLon = Math.toRadians(lon2 - lon1);
+        double a =
+            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
+            Math.cos(Math.toRadians(lat1)) * Math.cos(Math.toRadians(lat2)) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
+        return 2 * 6371000 * Math.asin(Math.min(1, Math.sqrt(a)));
+    }
+}
