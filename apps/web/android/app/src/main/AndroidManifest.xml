<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/icono_feliz"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icono_feliz"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
        </activity>

        <!-- Un acceso por cara de la mascota: MascotaPlugin deja prendido solo el que corresponde (como Duolingo). -->
        <activity-alias
            android:name=".IconoFeliz"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/icono_feliz"
            android:roundIcon="@mipmap/icono_feliz"
            android:label="@string/title_activity_main"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoEspera"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/icono_espera"
            android:roundIcon="@mipmap/icono_espera"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoTriste"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/icono_triste"
            android:roundIcon="@mipmap/icono_triste"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoDormida"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/icono_dormida"
            android:roundIcon="@mipmap/icono_dormida"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoManana"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/icono_manana"
            android:roundIcon="@mipmap/icono_manana"
            android:label="@string/title_activity_main"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- Los avisos push los muestra AvisosPushService (siempre), en lugar del servicio del plugin. -->
        <service android:name="com.capacitorjs.plugins.pushnotifications.MessagingService" tools:node="remove" />
        <!-- Los botones de los avisos que se contestan sin abrir la app (ver RespuestaReceiver). -->
        <receiver android:name=".RespuestaReceiver" android:exported="false" />
        <!-- Vuelve a levantar el seguimiento de la ubicación si se apagó (ver VigiaUbicacion). -->
        <receiver android:name=".VigiaUbicacion" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="ar.patty.app.VIGILAR_UBICACION" />
            </intent-filter>
        </receiver>
        <!-- Las llamadas medidas mientras pasan, cuando no hay permiso para el registro (ver LlamadasReceiver). -->
        <receiver android:name=".LlamadasReceiver" android:exported="true" android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        <!-- El widget de la pantalla de inicio (WidgetPatty). -->
        <receiver android:name=".WidgetPatty" android:exported="false" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_patty_info" />
        </receiver>
        <service android:name=".AvisosPushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_patty" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/patty_acento" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ubicación con la app cerrada (el resto de los de ubicación los agrega el plugin). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Datos del teléfono para Patty: tiempo de uso por app y registro de llamadas (solo cantidades y duraciones). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- La encuesta de la noche llega a la hora justa (Android lo da al instalar, sin pedir nada). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Dictar: grabar desde la web (el permiso de micrófono lo pide la app al primer uso). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Para ver el nombre de las apps usadas (Android 11+ esconde las demás apps si no). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
</manifest>
