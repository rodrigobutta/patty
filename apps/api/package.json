{
  "name": "api",
  "private": true,
  "version": "1.60.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "build": "pnpm --filter shared build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=.env src/db/migrar-cli.ts",
    "ejemplo": "tsx --conditions=source --env-file-if-exists=.env scripts/datos-ejemplo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@hono/node-server": "2.1.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "pdfkit": "0.20.2",
    "postgres": "3.4.9",
    "shared": "workspace:*",
    "svg-to-pdfkit": "0.1.8"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pdfkit": "0.17.7",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
