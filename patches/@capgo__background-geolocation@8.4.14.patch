+    // Patty: locations that could not be delivered (no signal on the road) are kept
+    // and sent with the next one as {"puntos": [...]}, instead of being lost.
+    private static final String KEY_PENDING = "pendingLocations";
+    private static final int MAX_PENDING = 3000;
+    private static final int BATCH = 400;
+
+    private static synchronized JSONArray pending(Context context) {
+        try {
+            return new JSONArray(prefs(context).getString(KEY_PENDING, "[]"));
+        } catch (JSONException e) {
+            return new JSONArray();
+        }
+    }
+
+    private static synchronized void savePending(Context context, JSONArray list) {
+        prefs(context).edit().putString(KEY_PENDING, list.toString()).apply();
+    }
+
+    private static synchronized void addPending(Context context, JSONObject data) {
+        JSONArray list = pending(context);
+        list.put(data);
+        if (list.length() > MAX_PENDING) {
+            JSONArray trimmed = new JSONArray();
+            for (int i = list.length() - MAX_PENDING; i < list.length(); i++) trimmed.put(list.opt(i));
+            list = trimmed;
+        }
+        savePending(context, list);
+    }
