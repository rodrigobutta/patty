<?xml version="1.0" encoding="utf-8"?>
<!-- El widget de Patty: el búho con su cara de hoy y la pregunta; las cuatro caritas anotan sin abrir la app, y
     "Contar" y "Foto" abren Patty directo en eso. Ver WidgetPatty.java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_fondo">

    <LinearLayout
        android:id="@+id/widget_cabeza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_buho"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="2dp"
            android:background="@drawable/widget_buho_fondo"
            android:src="@mipmap/icono_feliz_frente"
            android:contentDescription="@string/app_name" />

        <!-- La línea del día (o la pregunta) y, encima, el aviso de "Anotado" que aparece y se va solo
             (animateLayoutChanges hace el fundido). -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:animateLayoutChanges="true">

            <TextView
                android:id="@+id/widget_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/widget_pregunta"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/widget_texto" />

            <TextView
                android:id="@+id/widget_aviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/widget_aviso"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/widget_muy_bien" style="@style/WidgetCarita" android:text="😄" android:contentDescription="@string/widget_muy_bien" />
        <TextView android:id="@+id/widget_bien" style="@style/WidgetCarita" android:text="🙂" android:contentDescription="@string/widget_bien" />
        <TextView android:id="@+id/widget_mal" style="@style/WidgetCarita" android:text="😕" android:contentDescription="@string/widget_mal" />
        <TextView android:id="@+id/widget_muy_mal" style="@style/WidgetCarita" android:text="😣" android:contentDescription="@string/widget_muy_mal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/widget_contar" style="@style/WidgetBoton" android:text="@string/widget_contar" />
        <TextView android:id="@+id/widget_foto" style="@style/WidgetBoton" android:text="@string/widget_foto" />
    </LinearLayout>
</LinearLayout>
