# Base Postgres (en Railway la pone el plugin de Postgres).
DATABASE_URL=postgres://localhost/patty
# Puerto HTTP (Railway lo pone solo).
PORT=8000
# Carpeta con la web compilada. Por defecto ./static (en desarrollo la sirve Vite).
# STATIC_DIR=../web/dist
# Opcional: análisis de patrones y carga en texto libre con IA (Claude).
ANTHROPIC_API_KEY=
# Opcional: para claves que no están atadas a un workspace.
ANTHROPIC_WORKSPACE_ID=
# Opcional: dictar en cualquier teléfono (la transcripción la hace OpenAI). Sin esto, se usa el reconocedor del teléfono.
OPENAI_API_KEY=
# Opcional: cuenta de servicio de Firebase (el JSON entero, en una línea) para mandar avisos push.
FIREBASE_SERVICE_ACCOUNT=
# Opcional: "Continuar con Google" (ID de cliente OAuth de tipo Aplicación web).
GOOGLE_CLIENT_ID=
# Opcional: interfaz donde escucha (por defecto 0.0.0.0).
# HOST=0.0.0.0
